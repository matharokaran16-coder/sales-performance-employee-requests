@model List<SalesPerformanceManagement.Models.User>

@{
    ViewData["Title"] = "Employee Directory";

    string searchText = ViewBag.Search ?? "";
    string selectedSort = ViewBag.SortBy ?? "name";
    int? selectedRoleId = ViewBag.SelectedRoleId;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;

    Dictionary<int, decimal> salesTotals = ViewBag.SalesTotals ?? new Dictionary<int, decimal>();
    Dictionary<int, decimal> completionTotals = ViewBag.CompletionTotals ?? new Dictionary<int, decimal>();

    bool isHrManager = User.IsInRole("HR Manager");
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Employee Directory</h2>
            <p class="text-muted mb-0">Search, filter, and review employee information and sales performance.</p>
        </div>

        @if (isHrManager)
        {
            <a asp-controller="UserManagement" asp-action="Create" class="btn btn-primary">
                Create User
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-controller="UserManagement" asp-action="Index" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-4">
                        <label for="search" class="form-label">Search Employee</label>
                        <input type="text" name="search" id="search" class="form-control" value="@searchText" placeholder="Enter employee name" />
                    </div>

                    <div class="col-lg-3">
                        <label for="roleId" class="form-label">Filter by Role</label>
                        <select name="roleId" id="roleId" class="form-select" asp-items="ViewBag.RoleOptions">
                            <option value="">All Roles</option>
                        </select>
                    </div>

                    <div class="col-lg-3">
                        <label for="sortBy" class="form-label">Sort By</label>
                        <select name="sortBy" id="sortBy" class="form-select">
                            <option value="name" selected="@(selectedSort == "name")">Name (A-Z)</option>
                            <option value="sales" selected="@(selectedSort == "sales")">Total Sales (Highest First)</option>
                            <option value="completion" selected="@(selectedSort == "completion")">Target Completion (Highest First)</option>
                        </select>
                    </div>

                    <div class="col-lg-2">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Apply</button>
                            <a asp-controller="UserManagement" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Employees</h5>
            <span class="text-muted">@totalCount result(s)</span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Department</th>
                            <th>Total Sales</th>
                            <th>Target Completion</th>
                            <th>Status</th>

                            @if (isHrManager)
                            {
                                <th>Actions</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="@(isHrManager ? 8 : 7)" class="text-center text-muted py-4">
                                    No employees found. Try changing your search or filters.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var user in Model)
                            {
                                decimal totalSales = salesTotals.TryGetValue(user.UserId, out decimal salesValue) ? salesValue : 0;
                                decimal completion = completionTotals.TryGetValue(user.UserId, out decimal completionValue) ? completionValue : 0;

                                <tr>
                                    <td class="fw-semibold">@user.Name</td>
                                    <td>@user.Email</td>
                                    <td>@user.Role?.RoleName</td>
                                    <td>@user.Department?.DepartmentName</td>
                                    <td>@totalSales.ToString("0.##")</td>
                                    <td>@completion.ToString("0.00")%</td>

                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>

                                    @if (isHrManager)
                                    {
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a asp-controller="UserManagement" asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-primary">
                                                    Edit
                                                </a>

                                                @if (user.IsActive)
                                                {
                                                    <form asp-controller="UserManagement" asp-action="Deactivate" asp-route-id="@user.UserId" method="post" onsubmit="return confirm('Are you sure you want to deactivate this account?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            Deactivate
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer bg-white">
                <nav aria-label="Employee directory pages">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@searchText" asp-route-roleId="@selectedRoleId" asp-route-sortBy="@selectedSort" asp-route-page="@(currentPage - 1)">
                                Previous
                            </a>
                        </li>

                        @for (int pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                        {
                            <li class="page-item @(pageNumber == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-search="@searchText" asp-route-roleId="@selectedRoleId" asp-route-sortBy="@selectedSort" asp-route-page="@pageNumber">
                                    @pageNumber
                                </a>
                            </li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@searchText" asp-route-roleId="@selectedRoleId" asp-route-sortBy="@selectedSort" asp-route-page="@(currentPage + 1)">
                                Next
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>