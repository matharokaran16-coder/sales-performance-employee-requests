@model List<SalesPerformanceManagement.Models.User>

@{
    ViewData["Title"] = "User Management";
}

<div class="user-management-page">

    <div class="user-management-header">

        <div>
            <h1>User Management</h1>
            <p>Manage employee accounts, roles and access.</p>
        </div>

        <a asp-action="Create"
           class="user-create-button">
            + Create User
        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="user-table-card">

        <div class="user-table-header">
            <h3>Employees</h3>
            <span>@Model.Count total users</span>
        </div>

        <div class="table-responsive">

            <table class="user-table">

                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Work Email</th>
                        <th>Role</th>
                        <th>Department</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var user in Model)
                    {
                        <tr>

                            <td>
                                <div class="employee-name">
                                    @user.Name
                                </div>
                            </td>

                            <td>
                                @user.Email
                            </td>

                            <td>
                                <span class="role-label">
                                    @user.Role?.RoleName
                                </span>
                            </td>

                            <td>
                                @user.Department?.DepartmentName
                            </td>

                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="status-active">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="status-inactive">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td>

                                <div class="user-action-buttons">

                                    <a asp-action="Edit"
                                       asp-route-id="@user.UserId"
                                       class="user-edit-button">
                                        Edit
                                    </a>

                                    @if (user.IsActive)
                                    {
                                        <form asp-action="Deactivate"
                                              asp-route-id="@user.UserId"
                                              method="post"
                                              class="deactivate-form">

                                            <button type="submit"
                                                    class="user-deactivate-button">
                                                Deactivate
                                            </button>

                                        </form>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>