@model List<SalesPerformanceManagement.ViewModels.RequestListViewModel>

@{
    ViewData["Title"] = "Employee Requests";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="mb-1">Employee Requests</h2>
        <p class="text-muted mb-0">Review and process employee leave and shift change requests.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h5>No employee requests</h5>
                <p class="text-muted mb-0">There are currently no requests to review.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Employee</th>
                                <th>Request Type</th>
                                <th>Description</th>
                                <th>Submitted</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var request in Model)
                            {
                                string badgeClass = "bg-secondary";

                                if (request.StatusName == "Pending")
                                {
                                    badgeClass = "bg-warning text-dark";
                                }

                                if (request.StatusName == "Approved")
                                {
                                    badgeClass = "bg-success";
                                }

                                if (request.StatusName == "Rejected")
                                {
                                    badgeClass = "bg-danger";
                                }

                                <tr>
                                    <td>@request.EmployeeName</td>
                                    <td>@request.RequestTypeName</td>
                                    <td>@request.Description</td>
                                    <td>@request.CreatedDate.ToString("MMM dd, yyyy h:mm tt")</td>
                                    <td>
                                        <span class="badge @badgeClass">
                                            @request.StatusName
                                        </span>
                                    </td>

                                    <td>
                                        @if (request.StatusName == "Pending")
                                        {
                                            <div class="d-flex gap-2">
                                                <form asp-controller="Request" asp-action="Approve" method="post">
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="id" value="@request.RequestId" />

                                                    <button type="submit" class="btn btn-sm btn-success">
                                                        Approve
                                                    </button>
                                                </form>

                                                <form asp-controller="Request" asp-action="Reject" method="post">
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="id" value="@request.RequestId" />

                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        Reject
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Processed</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>