@model List<SalesPerformanceManagement.ViewModels.SalesTargetListViewModel>

@{
    ViewData["Title"] = "Sales Targets";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Sales Targets</h2>
            <p class="text-muted">
                Create and manage sales targets for Sales Representatives.
            </p>
        </div>

        <a asp-controller="SalesTarget"
           asp-action="Create"
           class="btn btn-primary">
            Create Sales Target
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No sales targets have been created yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">

                <thead>
                    <tr>
                        <th>Sales Representative</th>
                        <th>Target Value</th>
                        <th>Timeframe</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var target in Model)
                    {
                        <tr>
                            <td>
                                @target.SalesRepresentativeName
                            </td>

                            <td>
                                @target.TargetValue.ToString("N2")
                            </td>

                            <td>
                                @target.Timeframe
                            </td>

                            <td>
                                @target.StartDate.ToString("yyyy-MM-dd")
                            </td>

                            <td>
                                @target.EndDate.ToString("yyyy-MM-dd")
                            </td>

                            <td>
                                <a asp-controller="SalesTarget"
                                   asp-action="Edit"
                                   asp-route-id="@target.TargetId"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <form asp-controller="SalesTarget"
                                      asp-action="Delete"
                                      asp-route-id="@target.TargetId"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Are you sure you want to delete this sales target?');">
                                        Delete
                                    </button>

                                </form>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    }

</div>