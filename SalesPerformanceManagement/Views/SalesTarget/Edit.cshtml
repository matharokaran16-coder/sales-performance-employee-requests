@model SalesPerformanceManagement.ViewModels.EditSalesTargetViewModel

@{
    ViewData["Title"] = "Edit Sales Target";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Edit Sales Target</h2>

        <p class="text-muted">
            Update the target assignment and target details.
        </p>
    </div>

    <div class="card">
        <div class="card-body">

            <form asp-controller="SalesTarget"
                  asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="TargetId"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="SalesRepresentativeId"
                           class="form-label">
                    </label>

                    <select asp-for="SalesRepresentativeId"
                            asp-items="ViewBag.SalesRepresentatives"
                            class="form-select">

                        <option value="">
                            Select Sales Representative
                        </option>

                    </select>

                    <span asp-validation-for="SalesRepresentativeId"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="TargetValue"
                           class="form-label">
                    </label>

                    <input asp-for="TargetValue"
                           class="form-control" />

                    <span asp-validation-for="TargetValue"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Timeframe"
                           class="form-label">
                    </label>

                    <select asp-for="Timeframe"
                            asp-items="ViewBag.Timeframes"
                            class="form-select">

                        <option value="">
                            Select Timeframe
                        </option>

                    </select>

                    <span asp-validation-for="Timeframe"
                          class="text-danger">
                    </span>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="StartDate"
                               class="form-label">
                        </label>

                        <input asp-for="StartDate"
                               class="form-control" />

                        <span asp-validation-for="StartDate"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="EndDate"
                               class="form-label">
                        </label>

                        <input asp-for="EndDate"
                               class="form-control" />

                        <span asp-validation-for="EndDate"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-controller="SalesTarget"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}